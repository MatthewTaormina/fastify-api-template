# Server bind address. Default is loopback (127.0.0.1) because this API runs
# behind a reverse proxy. Use 0.0.0.0 for containerised deployments where the
# proxy is on a separate host.
HOST=127.0.0.1

# TCP port the server listens on.
PORT=3000

# Pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
